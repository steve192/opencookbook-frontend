{
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.17.2",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo start --tunnel --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build-web": "expo export --platform web && workbox generateSW workbox-config.js",
    "publish-expo-production": "npx -p eas-cli eas update --branch production --environment production --auto",
    "publish-expo-preview": "npx -p eas-cli eas update --branch preview --environment preview --auto",
    "publish-preview": "npx -p eas-cli eas update --branch preview --environment preview --auto",
    "build-android": "npx -p eas-cli eas build --platform android --profile=production",
    "build-android-apk": "npx -p eas-cli eas build --platform android --profile=production-apk",
    "build-android-dev": "npx -p eas-cli eas build --platform android --profile=development",
    "build-android-preview": "npx -p eas-cli eas build --platform android --profile=preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eva-design/eva": "2.2.0",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "7.19.0",
    "@react-navigation/elements": "2.9.41",
    "@react-navigation/native": "7.4.0",
    "@react-navigation/native-stack": "7.19.0",
    "@reduxjs/toolkit": "2.12.0",
    "@types/xdate": "0.8.35",
    "axios": "1.20.0",
    "buffer": "6.0.3",
    "expo": "57.0.24",
    "expo-application": "57.0.3",
    "expo-build-properties": "57.0.21",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "57.0.19",
    "expo-image-picker": "57.0.19",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.10",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.20",
    "expo-print": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "57.0.23",
    "fuzzy": "0.1.3",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.14",
    "react-icons": "5.7.0",
    "react-native": "0.86.3",
    "react-native-alarm-scheduler": "1.0.1",
    "react-native-cache": "2.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "9.3.0",
    "react-spacer": "1.3.0",
    "recyclerlistview": "4.2.3",
    "swiper": "12.2.0",
    "xdate": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "8.57.1",
    "eslint-config-google": "0.14.0",
    "eslint-plugin-react": "7.37.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.1",
    "workbox-cli": "7.4.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-cache"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "react-native-cache": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  },
  "private": true,
  "name": "opencookbook-frontend"
}
