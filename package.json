{
  "main": "node_modules/expo/AppEntry.js",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo start --tunnel --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "build-web": "expo export --platform web && workbox generateSW workbox-config.js",
    "publish-expo-production": "eas update --branch production --auto",
    "publish-expo-preview": "eas update --branch preview --auto",
    "publish-preview": "eas update --branch preview --auto",
    "build-android": "eas build --platform android --profile=production",
    "build-android-apk": "eas build --platform android --profile=production-apk",
    "build-android-dev": "eas build --platform android --profile=development",
    "build-android-preview": "eas build --platform android --profile=preview",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@eva-design/eva": "^2.1.1",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
