{
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.11.0",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo start --tunnel --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build-web": "expo export --platform web && workbox generateSW workbox-config.js",
    "publish-expo-production": "npx -p eas-cli eas update --branch production --environment production --auto",
    "publish-expo-preview": "npx -p eas-cli eas update --branch preview --environment preview --auto",
    "publish-preview": "npx -p eas-cli eas update --branch preview --environment preview --auto",
    "build-android": "npx -p eas-cli eas build --platform android --profile=production",
    "build-android-apk": "npx -p eas-cli eas build --platform android --profile=production-apk",
    "build-android-dev": "npx -p eas-cli eas build --platform android --profile=development",
    "build-android-preview": "npx -p eas-cli eas build --platform android --profile=preview",
    "cy:run": "cypress run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eva-design/eva": "^2.1.1",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.9.5",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@reduxjs/toolkit": "^2.10.1",
    "@types/xdate": "^0.8.35",
    "axios": "^1.13.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.19",
    "fuzzy": "^0.1.3",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-icons": "^4.3.1",
    "react-native": "0.86.3",
    "react-native-alarm-scheduler": "^0.3.0",
    "react-native-cache": "^2.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "react-spacer": "^1.3.0",
    "recyclerlistview": "^4.2.0",
    "swiper": "^8.0.7",
    "xdate": "^0.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.0",
    "@percy/cli": "^1.28.0",
    "@percy/cypress": "^3.1.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-preset-expo": "~57.0.0",
    "cypress": "^14.4.1",
    "eslint": "^8.7.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-react": "^7.28.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "workbox-cli": "^7.3.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-cache"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "react-native-cache": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  },
  "private": true,
  "name": "opencookbook-frontend"
}
