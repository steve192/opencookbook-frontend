    "typescript": "~5.9.2",
    "webpack": "^5.88.2",
    "webpack-dev-server": "^4.15.1",
    "workbox-cli": "^7.3.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-cache"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
