---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  priority?: boolean;
  class?: string;
}

const { image, alt, priority = false, class: className } = Astro.props;
---

<div class:list={['rounded-[2rem] border border-line bg-surface p-1.5 shadow-xl shadow-black/15', className]}>
  <Image
    src={image}
    alt={alt}
    widths={[360, 720]}
    sizes="(min-width: 640px) 260px, 45vw"
    priority={priority}
    class="h-auto w-full rounded-[1.6rem]"
  />
</div>
