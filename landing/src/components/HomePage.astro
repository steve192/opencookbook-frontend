---
import ClosingCta from './ClosingCta.astro';
import Faq from './Faq.astro';
import FeatureSection from './FeatureSection.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Platforms from './Platforms.astro';
import Ways from './Ways.astro';
import Layout from '../layouts/Layout.astro';
import { getContent, type Lang } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<Layout lang={lang} title={t.home.title} description={t.home.description} page="home">
  <Header lang={lang} page="home" />
  <main id="main">
    <Hero lang={lang} />
    <div id="features">
      {t.features.map((feature, i) => <FeatureSection lang={lang} feature={feature} flip={i % 2 === 1} />)}
    </div>
    <Platforms lang={lang} />
    <Ways lang={lang} />
    <Faq lang={lang} />
    <ClosingCta lang={lang} />
  </main>
  <Footer lang={lang} page="home" />
</Layout>
