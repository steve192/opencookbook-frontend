---
import { getContent, type Lang } from '../content';
import { linkTarget } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).faq;
---

<section id="faq" class="border-t border-line bg-bg-soft">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
    <h2 class="text-3xl font-bold tracking-tight">{t.title}</h2>
    <div class="mt-8 divide-y divide-line rounded-2xl border border-line bg-surface">
      {
        t.items.map((item) => (
          <details class="group p-5">
            <summary class="flex min-h-8 cursor-pointer list-none items-start justify-between gap-4 font-semibold">
              {item.question}
              <span class="text-xl leading-6 text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="mt-3 space-y-3 leading-7 text-muted">
              <p>{item.answer}</p>
              {item.link && <p><a href={item.link.href} {...linkTarget(item.link.href)} class="font-semibold text-brand underline underline-offset-4">{item.link.label}</a></p>}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
