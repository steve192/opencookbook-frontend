---
import CheckList from './CheckList.astro';
import PhoneStack from './PhoneStack.astro';
import type { Feature, Lang } from '../content';

interface Props {
  lang: Lang;
  feature: Feature;
  flip?: boolean;
}

const { lang, feature, flip = false } = Astro.props;
---

<section id={feature.id} class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:gap-16 md:py-20">
  <div class:list={[flip && 'md:order-2']}>
    <p class="text-sm font-semibold uppercase tracking-wider text-brand">{feature.eyebrow}</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight">{feature.title}</h2>
    <p class="mt-4 text-lg leading-8 text-muted">{feature.body}</p>
    <div class="mt-6"><CheckList items={feature.points} /></div>
  </div>
  <div class:list={[flip && 'md:order-1']}>
    <PhoneStack lang={lang} shots={feature.shots} />
  </div>
</section>
