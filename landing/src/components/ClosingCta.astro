---
import Button from './Button.astro';
import { getContent, type Lang } from '../content';
import { links, pagePaths } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section id="start" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
  <div class="rounded-3xl bg-brand-soft px-6 py-14 text-center sm:px-12">
    <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">{t.closing.title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t.closing.body}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href={links.signup}>{t.ui.signup}</Button>
      <Button href={pagePaths.selfHosting[lang]} variant="secondary">{t.nav.selfHosting}</Button>
    </div>
  </div>
</section>
