---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import { getContent, type Lang } from '../content';
import { SITE_URL, alternates, pagePaths, type PageKey } from '../site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Localized page pair. Without it the page is not localized and not indexed. */
  page?: PageKey;
}

const { lang, title, description, page } = Astro.props;
const url = (path: string) => new URL(path, SITE_URL).toString();
const pair = page ? pagePaths[page] : undefined;
const canonical = pair && url(pair[lang]);
const ogImage = url(`/og-${lang}.png`);
const t = getContent(lang);
const storageKey = 'cookpal-lang';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'CookPal',
    operatingSystem: 'Android, Web',
    applicationCategory: 'LifestyleApplication',
    inLanguage: lang,
    description: t.home.description,
    url: url(pagePaths.home[lang]),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'CookPal', url: url('/') },
];

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      pair && (
        <script is:inline define:vars={{ paths: pair, lang, storageKey }}>
          // Runs before paint. A stored choice wins; otherwise English pages forward German browsers.
          try {
            var stored = localStorage.getItem(storageKey);
            if (stored === 'en' || stored === 'de') {
              if (stored !== lang) location.replace(paths[stored]);
            } else if (lang === 'en') {
              var languages = navigator.languages || [navigator.language || ''];
              if (languages.some(function (l) { return /^de/i.test(l); })) location.replace(paths.de);
            }
          } catch (e) {}
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {!page && <meta name="robots" content="noindex" />}
    {
      page && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates(page).map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
        </>
      )
    }
    <meta name="theme-color" content="#fbf8f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12150f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CookPal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-lg bg-brand px-4 py-2 font-semibold text-on-brand focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50"
    >
      {t.ui.skipToContent}
    </a>
    <slot />
    <script is:inline define:vars={{ storageKey }}>
      document.querySelectorAll('[data-set-lang]').forEach(function (el) {
        el.addEventListener('click', function () {
          try {
            localStorage.setItem(storageKey, el.getAttribute('data-set-lang'));
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>
